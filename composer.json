{
    "name": "tjdft/laravel",
    "description": "Pacote unificado para desenvolvimento de aplicações Laravel no TJDFT.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "TJDFT"
        }
    ],
    "autoload": {
        "psr-4": {
            "TJDFT\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "TJDFT\\Laravel\\TJDFTLaravelServiceProvider"
            ]
        }
    },
    "require": {
        "socialiteproviders/keycloak": "^5.3",
        "technikermathe/blade-lucide-icons": "^3.137",
        "postare/blade-mdi": "^1.1",
        "sentry/sentry-laravel": "^4.20",
        "robsontenorio/mary": "^2.8",
        "livewire/livewire": "^4.2",
        "webonyx/graphql-php": "^15.30",
        "fakerphp/faker": "^1.24",
        "owen-it/laravel-auditing": "^14.0",
        "laravellegends/pt-br-validator": "^12.2"
    },
    "require-dev": {
        "orchestra/testbench": "^10.9",
        "pestphp/pest": "^4.4"
    },
    "autoload-dev": {
        "psr-4": {
            "TJDFT\\Laravel\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": [
            "php -d pcov.enabled=1 ./vendor/bin/pest --compact --colors --parallel"
        ],
        "test:coverage": [
            "php -d pcov.enabled=1 ./vendor/bin/pest --compact --coverage --colors=always --log-junit=.coverage/report.xml --coverage-html=.coverage/html --coverage-clover=.coverage/clover.xml --coverage-cobertura=.coverage/cobertura.xml"
        ],
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "build": "@php vendor/bin/testbench workbench:build --ansi",
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@build",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
